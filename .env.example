# Google Analytics 4 — leave unset locally; analytics renders nothing without it.
NEXT_PUBLIC_GA_ID=

# MongoDB connection string. Lead capture only — all page content is in-repo.
MONGODB_URI=

# Brevo (transactional email) — lead notifications from the gate problem form.
# API key: https://app.brevo.com/settings/keys/api  (v3 keys start "xkeysib-")
BREVO_API_KEY=

# Where lead notifications are delivered.
LEAD_NOTIFY_TO=office@shieldgaterepair.com

# Sender shown on the notification. The domain must be verified in Brevo
# (Senders, Domains & Dedicated IPs) or Brevo rejects the send.
BREVO_SENDER_EMAIL=office@shieldgaterepair.com
BREVO_SENDER_NAME=Shield Gate Repair Website

# Review request system
REVIEW_REQUEST_SECRET=
SMS_PROVIDER_KEY=

# ── Asset CDN (optional) ────────────────────────────────────────────────────
# Images and videos are mirrored to S3 and served through CloudFront. Set this
# to route them there. Leave it unset and everything falls back to the local
# /public paths — a missing CDN degrades to a working site, not a broken one.
#
# Inlined at build time, so changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_CDN_URL=https://d7t2eyla4jb9a.cloudfront.net

# Used only by scripts/sync-cdn.sh. AWS credentials are NOT read from this file
# — export them in your shell or use `aws configure`.
CDN_BUCKET=shield-gate-repair-assets
CDN_DISTRIBUTION_ID=EQLQJEJ0EPUUW
